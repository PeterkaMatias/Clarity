<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clarity">

        <!-- Módulo Tareas (Rodrigo) -->
        <activity
            android:name=".ui.tareas.TareasActivity"
            android:exported="false" />

        <!-- Dashboard principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autenticación y Registro -->
        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Chatbot / Asistente Virtual -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false" />

        <!-- Temporizador de Concentración (Focus Timer) -->
        <activity
            android:name=".ui.timer.FocusTimerActivity"
            android:exported="false" />

        <!-- Centro de Recursos y Detalle de Lectura -->
        <activity
            android:name=".ui.resources.RecursosActivity"
            android:exported="false" />

        <activity
            android:name=".ui.resources.DetalleRecursoActivity"
            android:exported="false" />

        <!-- Ajustes y Accesibilidad -->
        <activity
            android:name=".ui.settings.AjustesActivity"
            android:exported="false" />

        <!-- Formulario crear/editar tarea (Rodrigo) -->
        <activity
            android:name=".ui.tareas.FormularioTareaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Desglose IA de tarea (Rodrigo) -->
        <activity
            android:name=".ui.tareas.DesgloseTareaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>