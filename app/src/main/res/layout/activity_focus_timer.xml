<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/fondo_app">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "ESPACIO DE CONCENTRACIÓN"
            android:textColor="@color/gris_texto"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            />


        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "Momento de enfoque"
            android:textColor="@color/gris_texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text = "Una cosa a la vez. El resto puede esperar."
            android:textColor="@color/gris_texto"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTemporizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/blanco_superficie"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/contenedorDuraciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton5Min"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minWidth="0dp"
                        android:text="5 min"
                        android:textSize="12sp"
                        android:textColor="@color/blanco_superficie"
                        app:backgroundTint="@color/verde_principal"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton15Min"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minWidth="0dp"
                        android:text="15 min"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto"
                        app:backgroundTint="@color/verde_secundario"
                        app:cornerRadius="12dp"
                         />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton25Min"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minWidth="0dp"
                        android:text="25 min"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto"
                        app:backgroundTint="@color/verde_secundario"
                        app:cornerRadius="12dp"
                         />


                </LinearLayout>
                <FrameLayout
                    android:id="@+id/contenedorTemporizador"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/ic_temporizador">

                    <TextView
                        android:id="@+id/tvTiempoRestante"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="05:00"
                        android:textColor="@color/gris_texto"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/botonReiniciar"
                        android:layout_width="48dp"
                        android:layout_height="37dp"
                        android:contentDescription="Reiniciar temporizador"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text=""
                        app:backgroundTint="@color/verde_secundario"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_restart"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/verde_principal" />
                    <Button
                        android:id="@+id/botonComenzar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Comenzar" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvMensajeMotivacional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:text="No necesitas terminar todo. Solo quedarte con este momento."
                    android:textColor="@color/gris_texto"
                    android:textSize="14sp" />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/blanco_superficie"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tareasTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="SESION ACTUAL" />

                <TextView
                    android:id="@+id/tareasSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="start"
                    android:text="Tu intención"
                    android:textColor="@color/gris_texto"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTareaSeleccionada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:cardBackgroundColor="@color/fondo_app"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/verde_secundario"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iconoTarea"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_check_box"
                            android:contentDescription="Tarea seleccionada"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="TRABAJANDO EN"
                                android:textColor="@color/verde_principal"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTituloTarea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Estudiar programación"
                                android:textColor="@color/gris_texto"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSubtituloTarea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Repasar los temas del trabajo final."
                                android:textColor="@color/gris_texto"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/tareasMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="Avanzar despacio. Tambien es avanzar." />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
</ScrollView>