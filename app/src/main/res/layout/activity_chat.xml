<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- HEADER DE LUMI -->

    <LinearLayout
        android:id="@+id/headerLumi"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogoLumi"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Logo de Lumi"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lumi" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreLumi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lumi"
                android:textColor="@color/gris_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoLumi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Aquí para acompañarte"
                android:textColor="@color/verde_principal"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnMenuChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="•••"
            android:textColor="@color/verde_principal"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- BANNER -->

    <LinearLayout
        android:id="@+id/bannerLumi"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:background="@color/blanco_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerLumi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Un día a tu ritmo."
                android:textColor="@color/verde_principal"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="No tenés que hacerlo todo hoy."
                android:textColor="@color/verde_secundario"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="🌿"
            android:textSize="34sp" />

    </LinearLayout>

    <!-- MENSAJES -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/bannerLumi"
        app:layout_constraintBottom_toTopOf="@id/zonaAcciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SUGERENCIAS E INPUT -->

    <LinearLayout
        android:id="@+id/zonaAcciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fondo_app"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SUGERENCIAS DESLIZABLES HORIZONTALMENTE -->

        <HorizontalScrollView
            android:id="@+id/scrollSugerencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAcciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingEnd="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPasoAPaso"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="✓  Sí, paso a paso"
                    android:textColor="@color/verde_principal"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/blanco_superficie"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/verde_secundario"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAjustarPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="☷  Ajustar mi plan"
                    android:textColor="@color/verde_principal"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/blanco_superficie"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="@color/verde_secundario"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- CAJA DE TEXTO -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/blanco_superficie"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/verde_secundario"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/etMensaje"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Escribí lo que necesitás..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:paddingStart="2dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/gris_texto"
                    android:textColorHint="@color/verde_secundario"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Enviar mensaje"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/verde_principal"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_send_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="25dp"
                    app:iconTint="@color/blanco_superficie" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- NAVEGACIÓN INFERIOR: SIN CAMBIOS -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/blanco_superficie"
        android:elevation="8dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/verde_principal"
        app:itemTextColor="@color/verde_principal"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>