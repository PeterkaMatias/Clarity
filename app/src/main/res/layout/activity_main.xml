<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- CONTENIDO DESPLAZABLE -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollInicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ENCABEZADO COMÚN A AMBOS MODOS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSaludoUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Hola!"
                        android:textColor="@color/gris_texto"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMensajeMotivacional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Un paso a la vez, a tu propio ritmo."
                        android:textColor="@color/verde_principal"
                        android:textSize="14sp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnAbrirLogros"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Logros y progreso"
                    android:src="@drawable/ic_logros"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageButton
                    android:id="@+id/btnAbrirAjustes"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ajustes y accesibilidad"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/gris_texto" />

            </LinearLayout>

            <!-- ======================================= -->
            <!-- PANEL GENERAL                          -->
            <!-- ======================================= -->

            <LinearLayout
                android:id="@+id/panelGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- TARJETA DE PROGRESO -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/blanco_superficie"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/verde_secundario"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvNivelUsuario"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Modo General"
                                android:textColor="@color/gris_texto"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPuntosTotales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✨ 0 pts"
                                android:textColor="@color/verde_principal"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progresoNivel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="25"
                            app:indicatorColor="@color/verde_principal"
                            app:trackColor="@color/arena_decorativo"
                            app:trackCornerRadius="8dp"
                            app:trackThickness="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ACCESO RÁPIDO AL TEMPORIZADOR -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFocusRapido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/arena_decorativo"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="Temporizador de enfoque"
                            android:src="@drawable/ic_temporizador"
                            app:tint="@color/gris_texto" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modo Enfoque (Focus Timer)"
                                android:textColor="@color/gris_texto"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Iniciá un bloque corto para vencer la procrastinación"
                                android:textColor="@color/gris_texto"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- TÍTULO DE TAREAS Y BOTON VER TODAS  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mis focos de hoy"
                    android:textColor="@color/gris_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerTodasTareas"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver todas"
                        android:textColor="@color/verde_principal"
                        android:textSize="14sp" />

                    </LinearLayout>


                <!-- LISTA DE TAREAS -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTareasHoy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- ESTADO SIN TAREAS -->

                <TextView
                    android:id="@+id/tvSinTareas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="¡Todo despejado por hoy! 🎉&#10;Disfrutá tu descanso o agregá una nueva tarea."
                    android:textColor="@color/gris_texto"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ======================================= -->
            <!-- PANEL PARENTAL                         -->
            <!-- ======================================= -->

            <LinearLayout
                android:id="@+id/panelParental"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- TÍTULO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Panel Parental"
                    android:textColor="@color/verde_principal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- TARJETA DE GESTIÓN -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco_superficie"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/verde_secundario"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gestión del menor"
                            android:textColor="@color/gris_texto"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Desde este espacio podrás crear un perfil para el menor, organizar sus tareas y acompañar su progreso."
                            android:textColor="@color/gris_texto"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <Button
                            android:id="@+id/btnAdministrarMenores"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Administrar perfiles de menores"
                            android:backgroundTint="@color/verde_principal"
                            android:textColor="@color/blanco_superficie" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA INFERIOR FIJADA AL FONDO -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/blanco_superficie"
        android:elevation="8dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/verde_principal"
        app:itemTextColor="@color/verde_principal"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
