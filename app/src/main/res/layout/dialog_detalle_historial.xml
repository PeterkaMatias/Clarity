<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_historial"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogConsulta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consulta realizada"
        android:textColor="@color/gris_texto"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="13/11/2026"
        android:textColor="@color/verde_principal"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/verde_secundario" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvDialogRespuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:text="Respuesta completa de Lumi"
            android:textColor="@color/gris_texto"
            android:textIsSelectable="true"
            android:textSize="16sp" />

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarDetalleHistorial"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="Cerrar"
        android:textAllCaps="false"
        android:textColor="@color/blanco_superficie"
        android:textSize="15sp"
        app:backgroundTint="@color/verde_principal"
        app:cornerRadius="14dp" />

</LinearLayout>